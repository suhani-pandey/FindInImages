{
  "manifest_version": 3,
  "name": "Find in Images",
  "version": "1.0.0",
  "description": "Makes scanned PDFs and image-based documents searchable using Ctrl+F via OCR and DOM text injection.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html", "viewer/*", "lib/pdfjs/*", "lib/tesseract/*", "lib/tesseract/lang/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_title": "Search this PDF with OCR (Ctrl+Shift+F / ⌘⇧F)",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "toggle-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Search text in this PDF (switch to / from the OCR viewer)"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
