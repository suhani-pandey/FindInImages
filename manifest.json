{
  "manifest_version": 3,
  "name": "Find in Images",
  "version": "2.0.0",
  "description": "Press Ctrl+Shift+F on a scanned PDF: OCR embeds an invisible text layer and reopens it in Chrome's own viewer, so the normal Ctrl+F finds text inside images.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "offscreen",
    "storage",
    "contextMenus"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "action": {
    "default_title": "Search this PDF with OCR (Ctrl+Shift+F / ⌘⇧F)",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "toggle-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Make this PDF searchable with OCR (or restore the original)"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
